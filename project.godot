; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Heroes of the Last Stand"
config/description="Koop-Hero-Defense: Helden verteidigen gemeinsam den Kern gegen Gegnerwellen."
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/core/game_data.gd"
Session="*res://scripts/core/session.gd"
Audio="*res://scripts/core/audio_service.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.1, 1)
